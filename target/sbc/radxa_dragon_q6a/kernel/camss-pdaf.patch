+/* Stop every subdevice that started, including on a partial STREAMON failure. */
+static void video_stop_subdevs(struct camss_video *video,
+			       struct media_entity *first_not_started)
+{
+	struct media_entity *entity = &video->vdev.entity;
+	struct media_pad *pad;
+	struct v4l2_subdev *subdev;
+	int ret;
+
+	while (1) {
+		pad = &entity->pads[0];
+		if (!(pad->flags & MEDIA_PAD_FL_SINK))
+			break;
+		pad = media_pad_remote_pad_first(pad);
+		if (!pad || !is_media_entity_v4l2_subdev(pad->entity) ||
+		    pad->entity == first_not_started)
+			break;
+		entity = pad->entity;
+		subdev = media_entity_to_v4l2_subdev(entity);
+		ret = video_stop_subdev(subdev);
+		if (ret && ret != -ENOIOCTLCMD)
+			dev_err(video->camss->dev,
+				"Video pipeline stop failed: %d\n", ret);
+	}
