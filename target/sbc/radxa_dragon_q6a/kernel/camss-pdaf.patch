+	ret = v4l2_subdev_call(subdev, pad, get_fmt, NULL, &fmt);
+	if (ret)
+		return ret;
+	if (fmt.format.code != MEDIA_BUS_FMT_SENSOR_DATA)
+		return -EPIPE;
+	meta->dataformat = V4L2_META_FMT_GENERIC_8;
+	meta->buffersize = ALIGN(fmt.format.width * fmt.format.height,
+				 video->bpl_alignment);
+	return 0;
+}
