+/* Multiple RDI video nodes share the same CSID, CSIPHY and sensor subdevs. */
+struct camss_subdev_stream {
+	struct v4l2_subdev *subdev;
+	unsigned int users;
+	struct list_head list;
+};
+
+static LIST_HEAD(camss_subdev_streams);
+static DEFINE_MUTEX(camss_subdev_stream_lock);
+
+static int video_start_subdev(struct v4l2_subdev *subdev)
+{
+	struct camss_subdev_stream *stream;
+	int ret;
+
+	mutex_lock(&camss_subdev_stream_lock);
+	list_for_each_entry(stream, &camss_subdev_streams, list) {
+		if (stream->subdev == subdev) {
+			stream->users++;
+			mutex_unlock(&camss_subdev_stream_lock);
+			return 0;
+		}
+	}
+	stream = kzalloc(sizeof(*stream), GFP_KERNEL);
+	if (!stream) {
+		mutex_unlock(&camss_subdev_stream_lock);
+		return -ENOMEM;
+	}
+	ret = v4l2_subdev_call(subdev, video, s_stream, 1);
+	if (ret && ret != -ENOIOCTLCMD) {
+		kfree(stream);
+		mutex_unlock(&camss_subdev_stream_lock);
+		return ret;
+	}
+	stream->subdev = subdev;
+	stream->users = 1;
+	list_add(&stream->list, &camss_subdev_streams);
+	mutex_unlock(&camss_subdev_stream_lock);
+	return 0;
+}
