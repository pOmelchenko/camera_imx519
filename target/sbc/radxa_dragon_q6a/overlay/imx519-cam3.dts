// SPDX-License-Identifier: GPL-2.0-only
// Copyright (c) 2025 Radxa Computer (Shenzhen) Co., Ltd.
// Adapted for IMX519 on Q6A CAM3, 2026-10-11.
// CAM3 routing follows Radxa's Q6A IMX219 overlay (BSD-3-Clause).
// This initial configuration assumes the module has a 24 MHz oscillator
// and local sensor voltage regulators. It does not drive an SoC MCLK pin.
// VANA models the module enable; VDIG/VDDL use kernel dummy supplies.
// AK7375 and lens-focus follow the Raspberry Pi IMX519 module reference.
// The physical module, oscillator and autofocus are not yet verified.
/dts-v1/;
/plugin/;

/ {
    metadata {
        title = "Enable IMX519 camera on CAM3";
        compatible = "radxa,dragon-q6a";
        category = "camera";
        exclusive = "cci1_i2c1";
        description = "IMX519 RAW10, 2 lanes, module oscillator 24 MHz.";
    };
};

&{/} {
    imx519_cam3_clock: imx519-cam3-clock {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
        clock-output-names = "imx519_cam3_extclk";
    };

    imx519_cam3_enable: imx519-cam3-enable {
        compatible = "regulator-fixed";
        regulator-name = "imx519_cam3_enable";
        regulator-always-on;
        enable-active-high;
        gpios = <&tlmm 78 0>;
        pinctrl-names = "default";
        pinctrl-0 = <&imx519_cam3_enable_pins>;
    };
};

&{/reserved-memory} {
    linux,cma {
        compatible = "shared-dma-pool";
        size = <0x0 0x8000000>;
        reusable;
        linux,cma-default;
    };
};

&camss {
    vdda-phy-supply = <&vreg_l10c_0p88>;
    vdda-pll-supply = <&vreg_l6b_1p2>;
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@3 {
            reg = <3>;
            imx519_csiphy3_ep: endpoint {
                clock-lanes = <7>;
                data-lanes = <0 1>;
                remote-endpoint = <&imx519_cam3_ep>;
            };
        };
    };
};

&cci1 { status = "okay"; };

&cci1_i2c1 {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";
    imx519@1a {
        compatible = "sony,imx519";
        reg = <0x1a>;
        clocks = <&imx519_cam3_clock>;
        clock-names = "xclk";
        lens-focus = <&imx519_cam3_lens>;
        rotation = <0>;
        orientation = <2>;
        VANA-supply = <&imx519_cam3_enable>;
        port {
            imx519_cam3_ep: endpoint {
                clock-lanes = <0>;
                data-lanes = <1 2>;
                clock-noncontinuous;
                link-frequencies = /bits/ 64 <408000000>;
                remote-endpoint = <&imx519_csiphy3_ep>;
            };
        };
    };
    imx519_cam3_lens: ak7375@c {
        compatible = "asahi-kasei,ak7375";
        reg = <0x0c>;
        vdd-supply = <&imx519_cam3_enable>;
    };
};

&tlmm {
    imx519_cam3_enable_pins: imx519-cam3-enable-state {
        pins = "gpio78";
        function = "gpio";
        drive-strength = <2>;
        bias-pull-up;
    };
};
