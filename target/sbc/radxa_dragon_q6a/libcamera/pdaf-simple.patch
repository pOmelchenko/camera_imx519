+void SimpleCameraData::phaseBufferReady(FrameBuffer *buffer)
+{
+	if (buffer->metadata().status == FrameMetadata::FrameSuccess) {
+		MappedFrameBuffer mapped(buffer, MappedFrameBuffer::MapFlag::Read);
+		if (mapped.isValid() && !mapped.planes().empty()) {
+			Span<uint8_t> payload = mapped.planes()[0];
+			size_t length = std::min(payload.size(), static_cast<size_t>(
+						buffer->metadata().planes()[0].bytesused));
+			LOG(SimplePipeline, Debug) << "Phase buffer " << length
+						   << " bytes, plane " << payload.size();
+			if (length >= 970 && payload[0] == 0 && payload[1] < 0x40) {
+				std::vector<int32_t> phases;
+				for (unsigned int row = 3; row < 9; ++row) {
+					for (unsigned int column = 4; column < 12; ++column) {
+						size_t offset = 10 + (row * 16 + column) * 5;
+						int confidence = (payload[offset] << 3) |
+								 (payload[offset + 1] >> 5);
+						if (confidence < 16)
+							continue;
+						int phase = ((payload[offset + 1] & 0x0f) -
+							     (payload[offset + 1] & 0x10)) * 64 +
+							    (payload[offset + 2] >> 2);
+						phases.push_back(phase);
+					}
+				}
+				if (phases.size() >= 8) {
+					std::sort(phases.begin(), phases.end());
+					int32_t phase = (phases[(phases.size() - 1) / 2] +
+							 phases[phases.size() / 2]) / 2;
+					phaseSamples_.push_back({ buffer->metadata().timestamp,
+								  phase, static_cast<uint32_t>(phases.size()) });
+					if (phaseSamples_.size() > 32)
+						phaseSamples_.pop_front();
+					LOG(SimplePipeline, Debug) << "Phase sample " << phase
+							   << " regions " << phases.size();
+				}
+			}
+		} else {
+			LOG(SimplePipeline, Debug) << "Phase buffer mapping failed: "
+						   << mapped.error();
+		}
+	}
+
+	if (phaseStreaming_ && buffer->metadata().status != FrameMetadata::FrameCancelled)
+		phaseVideo_->queueBuffer(buffer);
+}
