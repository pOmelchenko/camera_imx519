+bool SimpleCameraData::setupPhase(const Size &sensorSize)
+{
+	phaseVideo_.reset();
+	if (sensor_->model() != "imx519" || sensorSize.width % 4)
+		return false;
+
+	MediaDevice *media = pipe()->captureMedia();
+	MediaEntity *csid = media->getEntityByName("msm_csid0");
+	MediaEntity *rdi = media->getEntityByName("msm_vfe0_rdi2");
+	MediaEntity *video = media->getEntityByName("msm_vfe0_video2");
+	MediaLink *link = media->link("msm_csid0", 3, "msm_vfe0_rdi2", 0);
+	if (!csid || !rdi || !video || !link)
+		return false;
+
+	V4L2Subdevice csidDevice(csid);
+	V4L2Subdevice rdiDevice(rdi);
+	if (csidDevice.open() || rdiDevice.open())
+		return false;
+
+	V4L2SubdeviceFormat format{};
+	format.code = kQ6aSensorDataCode;
+	format.size = { sensorSize.width * 5 / 4, 1 };
+	if (link->setEnabled(true) ||
+	    csidDevice.setFormat(3, &format, V4L2Subdevice::ActiveFormat) ||
+	    format.code != kQ6aSensorDataCode ||
+	    format.size != Size(sensorSize.width * 5 / 4, 1) ||
+	    rdiDevice.setFormat(0, &format, V4L2Subdevice::ActiveFormat)) {
+		LOG(SimplePipeline, Warning) << "IMX519 phase route unavailable";
+		return false;
+	}
+
+	phaseVideo_ = std::make_unique<V4L2VideoDevice>(video);
+	SharedFD handle(::open(video->deviceNode().c_str(), O_RDWR | O_CLOEXEC));
+	if (!handle.isValid() ||
+	    phaseVideo_->open(handle, V4L2_BUF_TYPE_META_CAPTURE)) {
+		phaseVideo_.reset();
+		return false;
+	}
+	V4L2DeviceFormat capture{};
+	capture.fourcc = V4L2PixelFormat(V4L2_META_FMT_GENERIC_8);
+	capture.size = format.size;
+	capture.planes[0].size = format.size.width;
+	if (phaseVideo_->setFormat(&capture) ||
+	    capture.fourcc != V4L2PixelFormat(V4L2_META_FMT_GENERIC_8) ||
+	    capture.planes[0].size < 970) {
+		LOG(SimplePipeline, Warning) << "IMX519 phase MET8 format unavailable";
+		phaseVideo_.reset();
+		return false;
+	}
+
+	LOG(SimplePipeline, Info) << "IMX519 phase stream on " << phaseVideo_->deviceNode()
+				  << " (" << capture.planes[0].size << " bytes)";
+	return true;
+}
