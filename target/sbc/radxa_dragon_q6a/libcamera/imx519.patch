+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <array>
+#include <cmath>
+#include <iostream>
+#include <utility>
+
+#include "camera_sensor_helper.h"
+#include "test.h"
+
+using namespace libcamera;
+using namespace libcamera::ipa;
+
+class Imx519HelperTest : public Test
+{
+protected:
+	int run() override
+	{
+		auto helper = CameraSensorHelperFactoryBase::create("imx519");
+		if (!helper || helper->blackLevel() != 4096) {
+			std::cerr << "IMX519 factory or black level is missing" << std::endl;
+			return TestFail;
+		}
+
+		/* Reference points from the Raspberry Pi IMX519 helper. */
+		const std::array<std::pair<uint32_t, double>, 4> references = {{
+			{ 0, 1.0 }, { 512, 2.0 }, { 768, 4.0 }, { 960, 16.0 }
+		}};
+		for (const auto &[code, gain] : references) {
+			if (std::abs(helper->gain(code) - gain) > 1e-9 ||
+			    helper->gainCode(gain) != code) {
+				std::cerr << "Incorrect IMX519 gain at code " << code << std::endl;
+				return TestFail;
+			}
+		}
+
+		/* All codes exposed by our kernel driver must be valid and increasing. */
+		double previous = 0;
+		for (uint32_t code = 0; code <= 960; ++code) {
+			double gain = helper->gain(code);
+			if (!std::isfinite(gain) || gain < 1 || gain > 16 || gain <= previous)
+				return TestFail;
+			previous = gain;
+		}
+		return TestPass;
+	}
+};
+TEST_REGISTER(Imx519HelperTest)
