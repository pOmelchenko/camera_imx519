@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Contrast autofocus for the simple software ISP. */
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, uint32_t frame,
+		     IPAFrameContext &frameContext, const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Stage { Idle, Coarse, Fine, Monitor };
+	void startScan(uint32_t frame);
+	void finishStep(uint32_t frame, double score);
+	void setPosition(int position, uint32_t frame);
+	int toRaw(float diopters) const;
+	float toDiopters(int raw) const;
+
+	bool enabled_ = false;
+	bool manualPositionSet_ = false;
+	bool paused_ = false;
+	bool pauseDeferred_ = false;
+	int32_t mode_ = 0;
+	int32_t state_ = 0;
+	int min_ = 0;
+	int max_ = 0;
+	int position_ = 0;
+	int bestPosition_ = 0;
+	uint32_t nextSampleFrame_ = 0;
+	unsigned int index_ = 0;
+	unsigned int lowScoreCount_ = 0;
+	double bestScore_ = 0;
+	Stage stage_ = Stage::Idle;
+	std::vector<int> positions_;
+};
+
+} /* namespace ipa::soft::algorithms */
+} /* namespace libcamera */
