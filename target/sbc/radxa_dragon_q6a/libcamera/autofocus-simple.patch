diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..da80f0b
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,206 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Contrast autofocus for the simple software ISP. */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+LOG_DEFINE_CATEGORY(IPASoftAutoFocus)
+namespace ipa::soft::algorithms {
+
+namespace {
+constexpr uint32_t kSettleFrames = 12;
+/* Provisional Arducam Pi mapping, pending 80-degree lens calibration. */
+constexpr float kMaximumDiopters = 15.0f;
+}
+
+int Af::init(IPAContext &context, const ValueNode &)
+{
+	context.ctrlMap[&controls::AfMode] = ControlInfo(controls::AfModeValues);
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::AfPause] = ControlInfo(controls::AfPauseValues);
+	context.ctrlMap[&controls::LensPosition] = ControlInfo(0.0f, kMaximumDiopters, 9.14f);
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &)
+{
+	min_ = context.configuration.focus.focus_min;
+	max_ = context.configuration.focus.focus_max;
+	enabled_ = max_ > min_;
+	manualPositionSet_ = false;
+	mode_ = controls::AfModeManual;
+	state_ = controls::AfStateIdle;
+	stage_ = Stage::Idle;
+	paused_ = false;
+	pauseDeferred_ = false;
+	position_ = enabled_ ? toRaw(9.14f) : min_;
+	return 0;
+}
+
+int Af::toRaw(float diopters) const
+{
+	float fraction = std::clamp(diopters / kMaximumDiopters, 0.0f, 1.0f);
+	return min_ + std::lround(fraction * (max_ - min_));
+}
+
+float Af::toDiopters(int raw) const
+{
+	return max_ > min_ ? kMaximumDiopters * (raw - min_) / (max_ - min_) : 0.0f;
+}
+
+void Af::setPosition(int position, uint32_t frame)
+{
+	position_ = std::clamp(position, min_, max_);
+	nextSampleFrame_ = frame + kSettleFrames;
+}
+
+void Af::startScan(uint32_t frame)
+{
+	if (!enabled_)
+		return;
+	positions_.clear();
+	constexpr unsigned int kCoarseSteps = 8;
+	for (unsigned int i = 0; i <= kCoarseSteps; ++i)
+		positions_.push_back(min_ + (max_ - min_) * i / kCoarseSteps);
+	index_ = 0;
+	bestScore_ = 0;
+	bestPosition_ = position_;
+	lowScoreCount_ = 0;
+	stage_ = Stage::Coarse;
+	state_ = controls::AfStateScanning;
+	setPosition(positions_.front(), frame);
+}
+
+void Af::queueRequest(IPAContext &, uint32_t frame, IPAFrameContext &,
+		      const ControlList &request)
+{
+	if (!enabled_)
+		return;
+
+	if (auto mode = request.get(controls::AfMode)) {
+		if (*mode != mode_ && *mode >= controls::AfModeManual &&
+		    *mode <= controls::AfModeContinuous) {
+			mode_ = *mode;
+			if (mode_ == controls::AfModeManual)
+				manualPositionSet_ = false;
+			stage_ = Stage::Idle;
+			state_ = controls::AfStateIdle;
+			paused_ = false;
+			pauseDeferred_ = false;
+			if (mode_ == controls::AfModeContinuous)
+				startScan(frame);
+		}
+	}
+
+	if (mode_ == controls::AfModeManual) {
+		if (auto diopters = request.get(controls::LensPosition)) {
+			setPosition(toRaw(*diopters), frame);
+			manualPositionSet_ = true;
+		}
+		return;
+	}
+
+	if (mode_ == controls::AfModeAuto) {
+		if (auto trigger = request.get(controls::AfTrigger)) {
+			if (*trigger == controls::AfTriggerStart &&
+			    (stage_ == Stage::Idle || stage_ == Stage::Monitor))
+				startScan(frame);
+			else if (*trigger == controls::AfTriggerCancel) {
+				stage_ = Stage::Idle;
+				state_ = controls::AfStateIdle;
+			}
+		}
+	}
+
+	if (mode_ == controls::AfModeContinuous) {
+		if (auto pause = request.get(controls::AfPause)) {
+			if (*pause == controls::AfPauseImmediate) {
+				paused_ = true;
+				pauseDeferred_ = false;
+			} else if (*pause == controls::AfPauseDeferred) {
+				pauseDeferred_ = true;
+				if (stage_ == Stage::Monitor)
+					paused_ = true;
+			} else if (*pause == controls::AfPauseResume) {
+				paused_ = false;
+				pauseDeferred_ = false;
+				nextSampleFrame_ = frame + kSettleFrames;
+			}
+		}
+	}
+}
+
+void Af::finishStep(uint32_t frame, double score)
+{
+	if (score > bestScore_) {
+		bestScore_ = score;
+		bestPosition_ = position_;
+	}
+	if (++index_ < positions_.size()) {
+		setPosition(positions_[index_], frame);
+		return;
+	}
+	if (stage_ == Stage::Coarse) {
+		positions_.clear();
+		int step = std::max(1, (max_ - min_) / 32);
+		for (int i = -3; i <= 3; ++i)
+			positions_.push_back(std::clamp(bestPosition_ + i * step, min_, max_));
+		index_ = 0;
+		bestScore_ = 0;
+		stage_ = Stage::Fine;
+		setPosition(positions_.front(), frame);
+		return;
+	}
+	setPosition(bestPosition_, frame);
+	state_ = bestScore_ > 0.0001 ? controls::AfStateFocused : controls::AfStateFailed;
+	stage_ = Stage::Monitor;
+	if (pauseDeferred_)
+		paused_ = true;
+	LOG(IPASoftAutoFocus, Info) << "Contrast AF position " << bestPosition_
+				     << " score " << bestScore_ << " state " << state_;
+}
+
+void Af::process(IPAContext &, uint32_t frame, IPAFrameContext &frameContext,
+		 const SwIspStats *stats, ControlList &metadata)
+{
+	if (!enabled_)
+		return;
+	if (!paused_ && stats && stats->valid && stats->focusSamples >= 64 &&
+	    frame >= nextSampleFrame_) {
+		double samples = stats->focusSamples;
+		double green = stats->sum_.g() / samples;
+		double score = (stats->focusSum / samples) / (green * green + 16.0);
+		if (stage_ == Stage::Coarse || stage_ == Stage::Fine)
+			finishStep(frame, score);
+		else if (stage_ == Stage::Monitor && mode_ == controls::AfModeContinuous) {
+			if (score < bestScore_ * 0.55)
+				++lowScoreCount_;
+			else
+				lowScoreCount_ = 0;
+			if (lowScoreCount_ >= 3)
+				startScan(frame);
+		}
+	}
+	frameContext.lens.focus_pos = mode_ == controls::AfModeManual && !manualPositionSet_
+		? -1 : position_;
+	metadata.set(controls::AfMode, mode_);
+	metadata.set(controls::AfState, state_);
+	if (mode_ != controls::AfModeManual || manualPositionSet_)
+		metadata.set(controls::LensPosition, toDiopters(position_));
+	if (mode_ == controls::AfModeContinuous) {
+		int32_t pauseState = paused_ ? controls::AfPauseStatePaused :
+			pauseDeferred_ ? controls::AfPauseStatePausing : controls::AfPauseStateRunning;
+		metadata.set(controls::AfPauseState, pauseState);
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+} /* namespace libcamera */
